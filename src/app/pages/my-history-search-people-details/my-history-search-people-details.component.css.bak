.header-section {
    height: 60px;
}

.history-details-page-new {
    height: calc(100vh - 65px);
    display: flex;
    flex-direction: column;
}

.history-details-main-header {
  background: var(--background-white);
  border-bottom: 1px solid var(--border-color);
  padding: 16px 24px;
}

.history-details-header-row-1 {
    margin-bottom: 16px;
}

.history-details-header-row-2 {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
}

.details-header-info {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
}

.details-header-info h2 {
    margin: 0;
    font-size: 1.5rem;
    color: var(--text-color);
}

.details-header-info .status-orange,
.details-header-info .status-green,
.details-header-info .status-red {
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 0.8rem;
}

.details-header-info .status-orange {
    background-color: #fffbe6; /* light orange background */
    color: #d97706; /* dark orange text */
}

.details-header-info .status-green {
    background-color: #ecfdf5; /* light green background */
    color: #059669; /* dark green text */
}

.details-header-info .status-red {
    background-color: #fef2f2; /* light red background */
    color: #ef4444; /* dark red text */
}

.details-header-info .results-count {
    font-size: 0.9rem;
    color: var(--text-muted);
}

.controls-right {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
}

.dropdown-wrapper {
  position: relative;
  display: inline-block;
}

.dropdown-control {
  background-color: var(--background-white);
  border: 1px solid var(--border-color);
  padding: 8px 12px;
  border-radius: 6px;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 14px;
  color: var(--text-color);
}

.dropdown-control i {
  color: var(--text-muted);
}

.dropdown-menu {
  position: absolute;
  background-color: white;
  min-width: 160px;
  box-shadow: 0px 8px 16px 0px rgba(0,0,0,0.2);
  z-index: 1;
  border-radius: 6px;
  overflow: hidden;
  display: none;
  right: 0; /* Align to the right */
}

.dropdown-menu.show {
  display: block;
}

.dropdown-item {
  color: black;
  padding: 12px 16px;
  text-decoration: none;
  display: block;
  font-size: 14px;
  cursor: pointer;
}

.dropdown-item:hover {
  background-color: #f1f1f1;
}

.history-details-content-new {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 20px;
    background: #f8fafc;
}

table {
    width: 100%;
    border-collapse: collapse;
    font-size: .8rem;
}

th, td {
    padding: 12px;
    text-align: left;
    border-bottom: 1px solid #e2e8f0;
}

th {
    background: #f8fafc;
    font-weight: 600;
    color: #64748b;
    font-size: 12px;
    text-transform: uppercase;
}

tbody tr:nth-child(even) {
    background-color: #f8fafc;
}

tbody tr:hover {
    background-color: #f1f1f1;
}

.status-orange {
  color: #f97316; /* Naranja */
  font-weight: 500;
}

.status-green {
  color: #22c55e; /* Verde */
  font-weight: 500;
}

.status-red {
  color: #ef4444; /* Rojo */
  font-weight: 500;
}

.polling-spinner {
  width: 16px;
  height: 16px;
  border: 2px solid #e2e8f0; /* Light grey border */
  border-top: 2px solid var(--primary-blue); /* Blue spinner color */
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  color: #64748b;
  text-align: center;
}

.empty-state .fas {
  font-size: 48px;
  margin-bottom: 16px;
  color: #94a3b8;
}

.empty-state h3 {
  margin-bottom: 8px;
  color: #1e293b;
}

.empty-state p {
  margin-bottom: 24px;
}

.empty-state button {
  background: #5b4fe5;
  color: white;
  border: none;
  padding: 10px 20px;
  border-radius: 6px;
  font-weight: 500;
  cursor: pointer;
}

.empty-state button:hover {
  background: #4a3edc;
}

.pagination {
  padding: 16px 20px;
  border-top: 1px solid #e2e8f0;
  background: white;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.pagination button {
  padding: 8px 12px;
  border: 1px solid #e2e8f0;
  background: white;
  border-radius: 4px;
  cursor: pointer;
  color: #64748b;
}

.pagination button:disabled {
  cursor: not-allowed;
  color: #94a3b8;
}

.pagination span {
  padding: 8px 12px;
  color: #64748b;
  font-size: 14px;
}

.btn-outline {
    background: none;
    border: 1px solid var(--border-color);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    color: var(--text-color);
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 8px;
}

.btn-outline:hover {
    background: var(--background-light);
}
